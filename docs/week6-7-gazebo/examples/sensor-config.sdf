<?xml version="1.0"?>
<sdf version="1.7">
  <model name="humanoid_robot_with_sensors">
    <pose>0 0 1 0 0 0</pose>
    <static>false</static>

    <!-- Basic humanoid links and joints (simplified) -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.1</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
    </link>

    <link name="torso">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.2</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.3</iyy>
          <iyz>0.0</iyz>
          <izz>0.2</izz>
        </inertia>
      </inertial>
    </link>

    <link name="head">
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.002</iyy>
          <iyz>0.0</iyz>
          <izz>0.002</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Joints -->
    <joint name="torso_joint" type="fixed">
      <parent>base_link</parent>
      <child>torso</child>
    </joint>

    <joint name="neck_joint" type="revolute">
      <parent>torso</parent>
      <child>head</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>10.0</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- LiDAR Sensor Configuration -->
    <link name="lidar_link">
      <pose>0 0 0.5 0 0 0</pose>  <!-- Positioned on top of head -->
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>head</parent>
      <child>lidar_link</child>
      <pose>0 0 0.1 0 0 0</pose>
    </joint>

    <!-- LiDAR Sensor -->
    <sensor name="humanoid_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- 360 degree horizontal scan -->
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <!-- Range parameters -->
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/humanoid_robot</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>

    <!-- Camera Sensor Configuration -->
    <link name="camera_link">
      <pose>0.05 0 0.45 0 0 0</pose>  <!-- Positioned in head -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.02 0.04 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.02 0.04 0.02</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>head</parent>
      <child>camera_link</child>
    </joint>

    <!-- RGB Camera -->
    <sensor name="humanoid_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>30</update_rate>
      <camera name="head_camera">
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/humanoid_robot</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
      </plugin>
    </sensor>

    <!-- IMU Sensor Configuration -->
    <link name="imu_link">
      <pose>0 0 0.1 0 0 0</pose>  <!-- Positioned in torso -->
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-06</iyy>
          <iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>torso</parent>
      <child>imu_link</child>
    </joint>

    <!-- IMU Sensor -->
    <sensor name="humanoid_imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>100</update_rate>
      <topic>imu/data</topic>
      <always_on>true</always_on>
      <plugin name="imu_controller" filename="libgazebo_ros_imu.so">
        <ros>
          <namespace>/humanoid_robot</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>

    <!-- Force/Torque Sensor Configuration -->
    <link name="left_foot">
      <pose>0.05 0 -0.4 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="left_ankle_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_foot</child>
    </joint>

    <!-- Force/Torque Sensor -->
    <sensor name="left_foot_force_torque" type="force_torque">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <force_torque>
        <frame>child</frame>
        <measure_direction>child_to_parent</measure_direction>
      </force_torque>
      <plugin name="ft_sensor_plugin" filename="libgazebo_ros_ft_sensor.so">
        <ros>
          <namespace>/humanoid_robot</namespace>
          <remapping>~/wrench:=left_foot/wrench</remapping>
        </ros>
        <frame_name>left_foot</frame_name>
      </plugin>
    </sensor>

    <!-- GPS Sensor Configuration -->
    <link name="gps_link">
      <pose>0 0 0.55 0 0 0</pose>  <!-- Positioned on top of head -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent>head</parent>
      <child>gps_link</child>
    </joint>

    <!-- GPS Sensor -->
    <sensor name="humanoid_gps" type="gps">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>1</update_rate>
      <always_on>true</always_on>
      <plugin name="gps_controller" filename="libgazebo_ros_gps.so">
        <ros>
          <namespace>/humanoid_robot</namespace>
          <remapping>~/out:=gps/fix</remapping>
        </ros>
        <frame_name>gps_link</frame_name>
        <update_rate>1.0</update_rate>
      </plugin>
    </sensor>

    <!-- Gazebo plugin for ROS control -->
    <plugin name="humanoid_controller" filename="libgazebo_ros_control.so">
      <robotNamespace>/humanoid_robot</robotNamespace>
      <robotParam>robot_description</robotParam>
    </plugin>
  </model>
</sdf>